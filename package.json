{
  "name": "kgs-2player",
  "version": "1.0.0",
  "private": true,
  "engines": {"node": ">=22 <27"},
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.cjs",
    "start": "node --env-file-if-exists=.env.local scripts/dev.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/e2e-matchmaking.cjs",
    "test:e2e:soccer": "node -e \"process.env.SOCCER_API_ONLY='1';require('./tests/e2e-soccer.cjs')\""
  },
  "dependencies": {"pg": "8.23.1"},
  "devDependencies": {"playwright": "1.64.1"}
}
